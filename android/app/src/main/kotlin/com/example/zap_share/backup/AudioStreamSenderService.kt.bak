package com.example.zap_share

import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.Service
import android.content.Context
import android.content.Intent
import android.media.AudioAttributes
import android.media.AudioFormat
import android.media.AudioPlaybackCaptureConfiguration
import android.media.AudioRecord
import android.media.MediaCodec
import android.media.MediaCodecInfo
import android.media.MediaFormat
import android.media.projection.MediaProjection
import android.media.projection.MediaProjectionManager
import android.os.Build
import android.os.IBinder
import android.util.Log
import androidx.annotation.RequiresApi
import androidx.core.app.NotificationCompat
import java.net.DatagramPacket
import java.net.DatagramSocket
import java.net.InetAddress
import java.util.concurrent.ArrayBlockingQueue
import java.util.concurrent.TimeUnit

/**
 * Bluetooth-level low-latency audio sender.
 *
 * Target: ~20ms glass-to-glass on local Wi-Fi (same as BT A2DP aptX)
 *
 * Architecture:
 *   Capture (10ms PCM) → Opus encode → UDP send
 *
 * Key design decisions:
 *   1. 10ms Opus frames  — best encode quality/latency tradeoff.
 *      (5ms adds encoder overhead; 20ms adds latency)
 *   2. NO FEC — XOR FEC adds 1 full group delay (40ms). Instead
 *      the receiver does PLC (Packet Loss Concealment) for lost packets.
 *      On Wi-Fi <1% loss, PLC is inaudible.
 *   3. DSCP EF (0xB8) — tells routers/APs to treat as voice traffic.
 *   4. Send pacing uses System.nanoTime() not Thread.sleep() for
 *      sub-millisecond precision.
 *   5. Capture timestamp stamped at first read, used as packet timestamp.
 *      Receiver uses this only for sequence ordering, NOT clock sync.
 *   6. 128 kbps Opus CBR — excellent quality, ~2.5KB per 10ms frame.
 */
class AudioStreamSenderService : Service() {

    companion object {
        const val ACTION_START      = "START_AUDIO_STREAM"
        const val ACTION_STOP       = "STOP_AUDIO_STREAM"
        const val EXTRA_RESULT_CODE = "resultCode"
        const val EXTRA_RESULT_DATA = "resultData"
        const val EXTRA_TARGET_IPS  = "targetIps"
        const val PORT         = 50005
        const val CONTROL_PORT = 50006   // kept for future use

        @Volatile var isRunning = false
            private set
    }

    private val TAG = "ZapShare"

    // ── Audio params ──────────────────────────────────────────────────────────
    private val SAMPLE_RATE      = 48000
    private val CHANNELS         = 2
    private val BYTES_PER_SAMPLE = 2
    private val FRAME_MS         = 10                              // 10ms frames
    private val FRAME_BYTES      = SAMPLE_RATE * CHANNELS * BYTES_PER_SAMPLE * FRAME_MS / 1000  // 1920
    private val BITRATE          = 128_000                         // 128 kbps

    // ── State ─────────────────────────────────────────────────────────────────
    private var audioRecord: AudioRecord? = null
    private var mediaProjection: MediaProjection? = null
    private var encoder: MediaCodec? = null
    private var udpSocket: DatagramSocket? = null
    private val targets = mutableListOf<InetAddress>()

    private var captureThread: Thread? = null
    private var encodeThread:  Thread? = null
    private var sendThread:    Thread? = null

    // Tiny queues: backpressure is intentional
    data class Frame(val pcm: ByteArray, val captureNs: Long)
    private val pcmQueue  = ArrayBlockingQueue<Frame>(4)     // ~40ms max
    private val sendQueue = ArrayBlockingQueue<ByteArray>(8) // ~80ms max

    // Pool to avoid per-frame allocation
    private val pool = ArrayBlockingQueue<ByteArray>(6)

    init { repeat(6) { pool.offer(ByteArray(FRAME_BYTES)) } }

    // ── Service lifecycle ─────────────────────────────────────────────────────

    override fun onCreate() { super.onCreate() }
    override fun onBind(intent: Intent?): IBinder? = null

    @RequiresApi(Build.VERSION_CODES.Q)
    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
        when (intent?.action) {
            ACTION_START -> {
                val code = intent.getIntExtra(EXTRA_RESULT_CODE, 0)
                val data = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU)
                    intent.getParcelableExtra(EXTRA_RESULT_DATA, Intent::class.java)
                else @Suppress("DEPRECATION") intent.getParcelableExtra(EXTRA_RESULT_DATA) as? Intent
                val ips = intent.getStringArrayExtra(EXTRA_TARGET_IPS)
                if (data != null && ips != null) {
                    targets.clear()
                    ips.forEach { ip ->
                        runCatching { targets.add(InetAddress.getByName(ip)) }
                            .onFailure { Log.e(TAG, "Bad IP $ip") }
                    }
                    postForeground()
                    startStreaming(code, data)
                }
            }
            ACTION_STOP -> { stopStreaming(); stopSelf() }
        }
        return START_NOT_STICKY
    }

    private fun postForeground() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            (getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager)
                .createNotificationChannel(
                    NotificationChannel("zapshare_audio", "Audio Sharing",
                        NotificationManager.IMPORTANCE_LOW))
        }
        val n = NotificationCompat.Builder(this, "zapshare_audio")
            .setContentTitle("ZapShare Audio Sharing")
            .setContentText("Streaming audio…")
            .setSmallIcon(android.R.drawable.ic_media_play)
            .setPriority(NotificationCompat.PRIORITY_LOW)
            .build()
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q)
            startForeground(1001, n,
                android.content.pm.ServiceInfo.FOREGROUND_SERVICE_TYPE_MEDIA_PROJECTION or
                android.content.pm.ServiceInfo.FOREGROUND_SERVICE_TYPE_MICROPHONE)
        else startForeground(1001, n)
    }

    // ── Streaming ─────────────────────────────────────────────────────────────

    @RequiresApi(Build.VERSION_CODES.Q)
    private fun startStreaming(resultCode: Int, resultData: Intent) {
        if (isRunning) return
        isRunning = true

        // MediaProjection
        val mpMgr = getSystemService(Context.MEDIA_PROJECTION_SERVICE) as MediaProjectionManager
        mediaProjection = mpMgr.getMediaProjection(resultCode, resultData)
        val mp = mediaProjection ?: run { Log.e(TAG, "MP null"); isRunning = false; return }

        // AudioRecord — PlaybackCapture of system audio
        val capCfg = AudioPlaybackCaptureConfiguration.Builder(mp)
            .addMatchingUsage(AudioAttributes.USAGE_MEDIA)
            .addMatchingUsage(AudioAttributes.USAGE_GAME)
            .addMatchingUsage(AudioAttributes.USAGE_UNKNOWN)
            .build()
        val minBuf = AudioRecord.getMinBufferSize(
            SAMPLE_RATE, AudioFormat.CHANNEL_IN_STEREO, AudioFormat.ENCODING_PCM_16BIT)
        audioRecord = AudioRecord.Builder()
            .setAudioFormat(AudioFormat.Builder()
                .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
                .setSampleRate(SAMPLE_RATE)
                .setChannelMask(AudioFormat.CHANNEL_IN_STEREO)
                .build())
            .setBufferSizeInBytes(maxOf(minBuf, FRAME_BYTES * 2))
            .setAudioPlaybackCaptureConfig(capCfg)
            .build()

        // UDP socket — DSCP EF for AP/router prioritization
        udpSocket = DatagramSocket().apply {
            trafficClass   = 0xB8          // DSCP EF = voice priority
            sendBufferSize = 64 * 1024     // keep kernel buffer tight
        }

        // Opus encoder — low-latency CBR
        runCatching {
            val fmt = MediaFormat.createAudioFormat("audio/opus", SAMPLE_RATE, CHANNELS).apply {
                setInteger(MediaFormat.KEY_BIT_RATE, BITRATE)
                setInteger(MediaFormat.KEY_BITRATE_MODE,
                    MediaCodecInfo.EncoderCapabilities.BITRATE_MODE_CBR)
                // KEY_LOW_LATENCY = 1 disables Opus look-ahead (saves ~10ms)
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R)
                    setInteger(MediaFormat.KEY_LOW_LATENCY, 1)
            }
            encoder = MediaCodec.createEncoderByType("audio/opus").also {
                it.configure(fmt, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE)
                it.start()
            }
            Log.i(TAG, "Encoder ready: ${FRAME_MS}ms frames, ${BITRATE/1000}kbps")
        }.onFailure { Log.e(TAG, "Encoder init failed: ${it.message}") }

        launchCapture()
        launchEncode()
        launchSend()
    }

    // ── Thread 1 · Capture ────────────────────────────────────────────────────

    private fun launchCapture() {
        captureThread = Thread {
            android.os.Process.setThreadPriority(android.os.Process.THREAD_PRIORITY_URGENT_AUDIO)

            audioRecord?.startRecording()
            if (audioRecord?.recordingState != AudioRecord.RECORDSTATE_RECORDING) {
                Log.e(TAG, "AudioRecord failed to start (state=${audioRecord?.state})")
                isRunning = false
                return@Thread
            }
            Log.i(TAG, "Capture started")

            while (isRunning) {
                // Get a pooled buffer (blocks max 30ms = 3 frames)
                val buf = pool.poll(30, TimeUnit.MILLISECONDS)
                if (buf == null) { Log.w(TAG, "Pool starved"); continue }

                var offset     = 0
                var captureNs  = 0L

                // Read exactly one frame of PCM
                var readError = false
                while (offset < FRAME_BYTES && isRunning && !readError) {
                    val n = audioRecord?.read(buf, offset, FRAME_BYTES - offset) ?: -1
                    if (n < 0) {
                        pool.offer(buf)
                        readError = true
                    } else if (n == 0) {
                        Thread.sleep(1)
                    } else {
                        if (captureNs == 0L)
                            captureNs = System.nanoTime() - (FRAME_MS * 1_000_000L / 2)
                        offset += n
                    }
                }

                if (!readError && offset == FRAME_BYTES) {
                    // Drop oldest if encode thread is behind
                    if (!pcmQueue.offer(Frame(buf, captureNs))) {
                        pcmQueue.poll()?.let { pool.offer(it.pcm) }
                        pcmQueue.offer(Frame(buf, captureNs))
                        Log.w(TAG, "PCM queue drop — encode falling behind")
                    }
                } else {
                    pool.offer(buf)
                }
            }
            Log.i(TAG, "Capture stopped")
        }.also { it.start() }
    }

    // ── Thread 2 · Encode ─────────────────────────────────────────────────────

    private fun launchEncode() {
        encodeThread = Thread {
            android.os.Process.setThreadPriority(android.os.Process.THREAD_PRIORITY_URGENT_AUDIO)

            val info       = MediaCodec.BufferInfo()
            var seq        = 0
            var ptsUs      = 0L              // monotonic PTS for codec
            val ptsDeltaUs = FRAME_MS * 1000L
            var lastCsd: ByteArray? = null   // last codec config packet
            var csdResendCounter = 0         // resend CSD every 200 audio frames

            Log.i(TAG, "Encode started")

            while (isRunning) {
                val frame = pcmQueue.poll(50, TimeUnit.MILLISECONDS)
                if (frame == null) continue
                val pcm   = frame.pcm
                val tsNs  = frame.captureNs
                val enc   = encoder

                if (enc == null) { pool.offer(pcm); continue }

                runCatching {
                    // Feed PCM to encoder
                    val inIdx = enc.dequeueInputBuffer(5_000)
                    if (inIdx >= 0) {
                        enc.getInputBuffer(inIdx)?.run { clear(); put(pcm) }
                        enc.queueInputBuffer(inIdx, 0, pcm.size, ptsUs, 0)
                        ptsUs += ptsDeltaUs
                    }
                    // Return buffer immediately — don't wait for output
                    pool.offer(pcm)

                    // Drain all available output
                    var outIdx = enc.dequeueOutputBuffer(info, 2_000)
                    while (outIdx >= 0) {
                        val ob = enc.getOutputBuffer(outIdx)
                        val isConfig = (info.flags and MediaCodec.BUFFER_FLAG_CODEC_CONFIG) != 0

                        if (ob != null && info.size > 0) {
                            val bytes = ByteArray(info.size).also { ob.get(it) }

                            if (isConfig) {
                                // Store CSD for periodic resend
                                lastCsd = bytes.copyOf()
                                val pkt = pack(0x02, 0, tsNs, bytes)
                                if (!sendQueue.offer(pkt)) { sendQueue.poll(); sendQueue.offer(pkt) }
                                Log.i(TAG, "CSD sent (${bytes.size}B)")
                            } else {
                                val pkt = pack(0x01, seq, tsNs, bytes)
                                if (!sendQueue.offer(pkt)) { sendQueue.poll(); sendQueue.offer(pkt) }
                                seq = (seq + 1) % 65536
                                csdResendCounter++
                                // Re-broadcast CSD every 200 audio packets (~2s)
                                // so late-joining or recovering receivers get codec info
                                if (csdResendCounter % 200 == 0) {
                                    lastCsd?.let { csd ->
                                        val resend = pack(0x02, 0, tsNs, csd)
                                        sendQueue.offer(resend)
                                        Log.d(TAG, "CSD resent (periodic)")
                                    }
                                }
                            }
                        }
                        enc.releaseOutputBuffer(outIdx, false)
                        outIdx = enc.dequeueOutputBuffer(info, 0)
                    }
                }.onFailure { e ->
                    Log.e(TAG, "Encode error: ${e.message}")
                    pool.offer(pcm)
                }
            }
            Log.i(TAG, "Encode stopped")
        }.also { it.start() }
    }

    // ── Thread 3 · Send (hardware-clock paced) ────────────────────────────────

    private fun launchSend() {
        sendThread = Thread {
            android.os.Process.setThreadPriority(android.os.Process.THREAD_PRIORITY_URGENT_AUDIO)

            val frameDurNs = FRAME_MS * 1_000_000L
            var tRef       = System.nanoTime()
            var audioSent  = 0L

            Log.i(TAG, "Send started (${targets.size} targets)")

            while (isRunning) {
                val pkt = sendQueue.poll(50, TimeUnit.MILLISECONDS)
                if (pkt == null) continue
                val type = pkt[0].toInt() and 0xFF

                if (type == 0x01) {
                    // Pace audio packets to one per FRAME_MS using spin-wait
                    // for the final 0.5ms to avoid sleep() overshoot
                    val deadline = tRef + audioSent * frameDurNs
                    val sleepNs  = deadline - System.nanoTime()
                    if (sleepNs > 1_500_000L) {
                        Thread.sleep((sleepNs - 1_000_000L) / 1_000_000L)
                    }
                    // Spin for sub-ms precision
                    while (System.nanoTime() < deadline) { /* spin */ }

                    // Reset reference if we're more than 4 frames behind
                    if (System.nanoTime() - deadline > frameDurNs * 4) {
                        tRef = System.nanoTime()
                        audioSent = 0L
                        Log.w(TAG, "Send pace reset")
                    }
                    audioSent++
                }

                for (addr in targets) {
                    runCatching {
                        udpSocket?.send(DatagramPacket(pkt, pkt.size, addr, PORT))
                    }.onFailure { Log.w(TAG, "Send err to $addr: ${it.message}") }
                }
            }
            Log.i(TAG, "Send stopped")
        }.also { it.start() }
    }

    // ── Packet builder ────────────────────────────────────────────────────────

    /**
     * Wire format (11-byte header):
     *   [0]      type    : 0x01=audio, 0x02=codec-config
     *   [1..2]   seq     : big-endian uint16
     *   [3..10]  tsNs    : capture timestamp (big-endian int64) — used by
     *                      receiver ONLY to detect gaps, not for clock sync
     *   [11..]   payload : Opus bitstream
     */
    private fun pack(type: Int, seq: Int, tsNs: Long, payload: ByteArray): ByteArray {
        val pkt = ByteArray(11 + payload.size)
        pkt[0] = type.toByte()
        pkt[1] = ((seq shr 8) and 0xFF).toByte()
        pkt[2] = (seq and 0xFF).toByte()
        for (i in 0..7) pkt[3 + i] = ((tsNs shr ((7 - i) * 8)) and 0xFF).toByte()
        payload.copyInto(pkt, 11)
        return pkt
    }

    // ── Teardown ──────────────────────────────────────────────────────────────

    private fun stopStreaming() {
        isRunning = false

        // Signal threads to exit, close socket so recv unblocks
        captureThread?.interrupt()
        encodeThread?.interrupt()
        sendThread?.interrupt()
        pcmQueue.clear(); sendQueue.clear()

        // CRITICAL: join threads BEFORE releasing AudioRecord / encoder.
        // Releasing while a thread is still inside audioRecord.read() or
        // encoder.dequeueInputBuffer() causes a native crash.
        runCatching { captureThread?.join(800) }
        runCatching { encodeThread?.join(800) }
        runCatching { sendThread?.join(300) }

        runCatching { audioRecord?.stop() }
        runCatching { audioRecord?.release() }
        audioRecord = null

        runCatching { encoder?.stop() }
        runCatching { encoder?.release() }
        encoder = null

        runCatching { mediaProjection?.stop() }
        mediaProjection = null

        runCatching { udpSocket?.close() }
        udpSocket = null

        Log.i(TAG, "Streaming stopped")
    }

    override fun onDestroy() { stopStreaming(); super.onDestroy() }
}